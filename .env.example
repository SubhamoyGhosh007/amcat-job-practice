# Copy to .env and fill in keys. Never commit .env.
# AI question generation (fixed models, nothing asked in the UI).
# Preferred path: self-hosted proxy on the voice VPS (VITE_TTS_URL below) —
# the Google key then lives ONLY in the server's env, never in this bundle.
# Direct browser calls (VITE_GEMINI_API_KEY) still work as fallback.
# NOTE: OpenCode Zen rejects browser origins (CORS), so the zen provider only
# works from servers/agents.
VITE_AI_PROVIDER=gemini
VITE_OPENCODE_API_KEY=
VITE_OPENCODE_MODEL=muse-spark-1.3-contributor-free
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-3.5-flash
# Groq (OpenAI-compatible, generous free tier) — tried FIRST when set.
# Free users get llama-3.1-8b-instant; pro users toggle the heavyweights in-UI.
# Get one free at console.groq.com → API Keys. Note: it ships in the browser
# bundle (same as the Zen key above), so prefer a key with no billing attached.
VITE_GROQ_API_KEY=

# Supabase: auth + Postgres in one (no other backend).
# From Supabase dashboard → Project Settings → API. Auth needs zero keys
# beyond these two — Email/Google/GitHub are switched on in the dashboard.

# Supabase Postgres (optional — without these, score sheets stay in this browser)
# From Supabase dashboard → Project Settings → API: Project URL + publishable
# key (sb_publishable_...). The legacy anon key still works until end of 2026,
# then stops — use publishable. NEVER put the secret key (sb_secret_...) here;
# it must never ship in browser code. See README for the SQL + RLS setup and
# the Clerk connection (Supabase → Authentication → Third-Party Auth → add
# Clerk with your Frontend API domain, then complete Clerk's Connect with
# Supabase page).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Self-hosted Piper TTS voice server (optional — speaking lab needs it for
# listen/repeat exercises; read-aloud recording works without it)
# VITE_TTS_URL=https://pipertts.yourdomain.com
# VITE_TTS_TOKEN=paste-the-same-token-as-the-server-.env
VITE_TTS_URL=
VITE_TTS_TOKEN=
